# The demo company whose owner key this app holds. An owner key can add and remove members and
# cannot pay, so it cannot move the company's USDC. Server-only: never prefix these with NEXT_PUBLIC_.
DEMO_COMPANY=demo.settlekeys.testnet
DEMO_SUPPLIER=milk-supplier.settlekeys.testnet
DEMO_OWNER_KEY=ed25519:...

# Vercel sends this as a bearer token when it runs /api/cron/cleanup. Any long random string.
CRON_SECRET=

# Which company the pages open by default. Visitors can see these.
NEXT_PUBLIC_COMPANY=chaipoint.settlekeys.testnet
NEXT_PUBLIC_SUPPLIER=milk-supplier.settlekeys.testnet

# Optional RPC overrides. The browser needs one that allows cross-origin requests.
# NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR_RPC_URL=https://rpc.testnet.near.org
